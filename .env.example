# Copia questo file in ".env" (stessa cartella di docker-compose.yml) e inserisci le tue chiavi.
# Il file .env è ignorato da git: non committare mai le chiavi vere.

# Indirizzo del backend come lo vede il browser. Lascia localhost se usi l'app dallo stesso PC;
# metti l'IP di LAN (es. http://192.168.1.10:5161) per aprirla da un altro dispositivo.
API_PUBLIC_URL=http://localhost:5161

JWT_SIGNING_KEY=sviluppo-solo-chiave-lunga-almeno-32-caratteri
GRAPHHOPPER_API_KEY=
OPENROUTESERVICE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-mail. Con SMTP_USERNAME vuoto le e-mail NON partono: vengono solo scritte nel log del backend.
# Mailtrap (sviluppo): le e-mail finiscono in una casella finta su mailtrap.io -> Email Testing -> SMTP credentials.
# Gmail (invio reale): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, utente = indirizzo Gmail,
#   password = "password per le app" dell'account Google, SMTP_FROM_ADDRESS = lo stesso indirizzo Gmail.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@gocare.it
